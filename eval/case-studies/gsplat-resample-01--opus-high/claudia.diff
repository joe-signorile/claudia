+    state.statusLine = "No splats to export.";
+    return;
+  }
+  std::string err;
+  if (italy::saveGsplatPly(state.splatExportPathBuf, state.splatAsset, err)) {
+    state.statusLine = "Wrote " + std::to_string(state.splatAsset.count()) + " splats to " +
+                        std::string(state.splatExportPathBuf);
+  } else {
+    state.statusLine = "Failed to write " + std::string(state.splatExportPathBuf) + ": " + err;
+    std::fprintf(stderr, "italy: %s\n", state.statusLine.c_str());
+  }
+}
