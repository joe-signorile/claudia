+// The 3DGS parameterization's activation functions, and their inverses.
+//
+// A `.ply` stores raw fitted parameters (log-scale, pre-sigmoid opacity, SH
+// coefficients); GsplatAsset below stores them activated. Both directions
+// live here rather than privately in the loader because there are now two
+// producers (gsplat_ply_loader.cpp, convert/mesh_to_gsplat.cpp) and one
+// consumer that has to undo them (gsplat_ply_writer.cpp) — a drifting copy
+// of kShC0 or a sigmoid/logit pair that don't invert each other would show
+// up as a silently wrong colour or opacity on round-trip, not as a build
+// error.
+
+// SH-DC-to-RGB: constant term of a real spherical harmonic basis, the same
+// value the 3DGS reference implementation and every compatible exporter use.
+constexpr float kShC0 = 0.28209479177387814f;
+
+inline float gsplatActivateScale(float logScale) { return std::exp(logScale); }
+inline float gsplatActivateOpacity(float logit) { return 1.0f / (1.0f + std::exp(-logit)); }
+inline float gsplatShDcToRgb(float dc) { return 0.5f + kShC0 * dc; }
+
+// Inverses, for writing a `.ply` back out. Opacity is clamped away from 0
+// and 1 first: those are exactly the values a mesh fit produces (it emits
+// fully opaque splats), and logit(1) is +inf, which no PLY reader will
+// accept. The clamp costs ~1e-6 of opacity and keeps the file loadable.
+inline float gsplatDeactivateScale(float scale) { return std::log(std::max(scale, 1e-20f)); }
+inline float gsplatDeactivateOpacity(float opacity) {
+  const float a = std::clamp(opacity, 1e-6f, 1.0f - 1e-6f);
+  return std::log(a / (1.0f - a));
+}
