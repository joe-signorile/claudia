diff --git a/src/convert/mesh_to_gsplat.cpp b/src/convert/mesh_to_gsplat.cpp
new file mode 100644
index 0000000..d60d5c6
--- /dev/null
+++ b/src/convert/mesh_to_gsplat.cpp
@@ -0,0 +1,206 @@
+#include "convert/mesh_to_gsplat.h"
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+
+#include <glm/gtc/quaternion.hpp>
+
+#include "convert/texture_sample.h"
+
+namespace italy {
+namespace {
+
+constexpr float kPi = 3.14159265358979323846f;
+
+// Below this the ellipsoid is numerically degenerate: __intersection__gsplat
+// divides the ray by `scale` component-wise, so a zero sigma is an infinity
+// in the quadratic. Expressed relative to the tangential radius so it scales
+// with the scene rather than assuming metres.
+constexpr float kMinFlatness = 1e-3f;
+
+// One splat's worth of low-discrepancy 2D sample. Radical inverse base 2 for
+// one axis, the sample's own index for the other — the standard Hammersley
+// set. Plain uniform random would clump and leave visible holes at the splat
+// counts this runs at; a stratified set spreads the same count of splats over
+// the same area with far fewer gaps to see through (doctrine 1).
+float radicalInverse2(uint32_t i) {
+  i = (i << 16u) | (i >> 16u);
+  i = ((i & 0x55555555u) << 1u) | ((i & 0xaaaaaaaau) >> 1u);
+  i = ((i & 0x33333333u) << 2u) | ((i & 0xccccccccu) >> 2u);
+  i = ((i & 0x0f0f0f0fu) << 4u) | ((i & 0xf0f0f0f0u) >> 4u);
+  i = ((i & 0x00ff00ffu) << 8u) | ((i & 0xff00ff00u) >> 8u);
+  return static_cast<float>(i) * 2.3283064365386963e-10f; // / 2^32
+}
+
+// Deterministic hash used only to Cranley-Patterson rotate each triangle's
+// Hammersley set by its own offset. Without it every triangle gets the *same*
+// point pattern, and on a regular mesh (a subdivided plane, a UV sphere) that
+// lines the splats up into a visible lattice across the whole surface.
+uint32_t hashCombine(uint32_t a, uint32_t b) {
+  uint32_t h = a ^ (b + 0x9e3779b9u + (a << 6) + (a >> 2));
+  h ^= h >> 16;
+  h *= 0x7feb352du;
+  h ^= h >> 15;
+  h *= 0x846ca68bu;
+  h ^= h >> 16;
+  return h;
+}
+
+float unitFloat(uint32_t h) { return static_cast<float>(h) * 2.3283064365386963e-10f; }
+
+// Any orthonormal tangent will do: the two tangential sigmas are equal, so
+// the splat is rotationally symmetric about its normal and the frame's spin
+// is unobservable. This only has to be numerically stable, which is why it
+// builds from whichever cardinal axis the normal is *least* aligned with.
+glm::vec3 stableTangent(const glm::vec3 &n) {
+  const glm::vec3 axis = std::abs(n.x) < 0.9f ? glm::vec3(1, 0, 0) : glm::vec3(0, 1, 0);
+  return glm::normalize(glm::cross(axis, n));
+}
+
+// Base colour at a point inside a triangle, resolved through that triangle's
+// own material. Same compositing glTF specifies (baseColorFactor *
+// baseColorTexture) and the same convention voxelize.cpp's triangleColor()
+// uses, but sampled at the splat's barycentric UV rather than the triangle
+// centroid — a splat is a point, and averaging a whole triangle's UVs would
+// flatten the texture across every large triangle in the mesh.
+glm::vec3 splatColor(const MeshAsset &mesh, size_t triangle, const glm::vec3 &bary) {
+  const MaterialAsset &mat = mesh.materialForTriangle(triangle);
+  const size_t base = triangle * 3;
+  if (mat.baseColorTexture >= 0 && mat.baseColorTexture < static_cast<int>(mesh.textures.size()) &&
+      base + 2 < mesh.uvs.size()) {
+    const TextureAsset &tex = mesh.textures[mat.baseColorTexture];
+    if (tex.width > 0 && tex.height > 0) {
+      const glm::vec2 uv =
+          mesh.uvs[base] * bary.x + mesh.uvs[base + 1] * bary.y + mesh.uvs[base + 2] * bary.z;
+      return sampleColorBilinear(tex, uv) * mat.baseColorFactor;
+    }
+  }
+  return mat.baseColorFactor;
+}
+
+} // namespace
+
+GsplatAsset fitGsplatsToMesh(const MeshAsset &mesh, const GsplatFitSettings &settings) {
+  GsplatAsset out;
+
+  const size_t triangleCount = mesh.triangleCount();
+  const int requested = std::max(0, settings.splatCount);
+  if (triangleCount == 0 || requested == 0)
+    return out;
+
+  // Pass 1: triangle areas and their running total. Double, because a
+  // detailed mesh's areas span many orders of magnitude and the prefix below
+  // is what the whole per-triangle quota is derived from — accumulating that
+  // in float loses the smallest triangles entirely.
+  std::vector<double> prefixArea(triangleCount + 1, 0.0);
+  for (size_t t = 0; t < triangleCount; ++t) {
+    const glm::vec3 &v0 = mesh.positions[t * 3];
+    const glm::vec3 &v1 = mesh.positions[t * 3 + 1];
+    const glm::vec3 &v2 = mesh.positions[t * 3 + 2];
+    const double area = 0.5 * glm::length(glm::cross(v1 - v0, v2 - v0));
+    prefixArea[t + 1] = prefixArea[t] + area;
+  }
+  const double totalArea = prefixArea[triangleCount];
+  if (!(totalArea > 0.0))
+    return out; // degenerate soup (all-collinear triangles) — nothing to sample
+
+  // Sampling is area-uniform, so splat density is uniform and one radius is
+  // correct everywhere: each splat's share of the surface is totalArea/N, and
+  // the disk with that area has radius sqrt(area/pi). `coverage` then scales
+  // it past touching into overlapping.
+  const float shareRadius = std::sqrt(static_cast<float>(totalArea) / (static_cast<float>(requested) * kPi));
+  const float radius = std::max(settings.coverage, 0.0f) * shareRadius;
+  const float thickness = std::max(settings.flatness, kMinFlatness) * radius;
+  const glm::vec3 scale(radius, radius, thickness);
+  const float opacity = std::clamp(settings.opacity, 0.0f, 1.0f);
+
+  out.positions.reserve(static_cast<size_t>(requested));
+  out.scales.reserve(static_cast<size_t>(requested));
+  out.rotations.reserve(static_cast<size_t>(requested));
+  out.opacity.reserve(static_cast<size_t>(requested));
+  out.colorDC.reserve(static_cast<size_t>(requested));
+
+  const bool haveNormals = mesh.normals.size() >= mesh.positions.size();
+
+  // Pass 2: emit. The per-triangle quota comes from the *rounded running
+  // prefix* rather than rounding each triangle's own share independently —
+  // that makes the counts telescope, so they sum to exactly `requested` with
+  // no leftover to redistribute and no randomness in how many splats you get.
+  long long emitted = 0;
+  for (size_t t = 0; t < triangleCount; ++t) {
+    const long long upTo =
+        std::llround(prefixArea[t + 1] / totalArea * static_cast<double>(requested));
+    const long long quota = upTo - emitted;
+    emitted = upTo;
+    if (quota <= 0)
+      continue;
+
+    const glm::vec3 &v0 = mesh.positions[t * 3];
+    const glm::vec3 &v1 = mesh.positions[t * 3 + 1];
+    const glm::vec3 &v2 = mesh.positions[t * 3 + 2];
+    const glm::vec3 geoNormalRaw = glm::cross(v1 - v0, v2 - v0);
+    const float geoLen = glm::length(geoNormalRaw);
+    const glm::vec3 geoNormal = geoLen > 0.0f ? geoNormalRaw / geoLen : glm::vec3(0, 1, 0);
+
+    const uint32_t h = hashCombine(settings.seed, static_cast<uint32_t>(t));
+    const float jitterA = unitFloat(h);
+    const float jitterB = unitFloat(hashCombine(h, 0x85ebca6bu));
+
+    for (long long j = 0; j < quota; ++j) {
+      // Cranley-Patterson rotation: shift the stratified set by the
+      // triangle's own offset and wrap. Keeps the low-discrepancy spacing
+      // within the triangle while decorrelating triangle from triangle.
+      float a = (static_cast<float>(j) + 0.5f) / static_cast<float>(quota) + jitterA;
+      float b = radicalInverse2(static_cast<uint32_t>(j)) + jitterB;
+      a -= std::floor(a);
+      b -= std::floor(b);
+
+      // Standard uniform-area warp from the unit square onto the triangle.
+      const float su = std::sqrt(a);
+      const glm::vec3 bary(1.0f - su, su * (1.0f - b), su * b);
+      const glm::vec3 position = v0 * bary.x + v1 * bary.y + v2 * bary.z;
+
+      // Shading normal, not the geometric one: on a smooth-shaded mesh it's
+      // what makes a curved surface's splats fan out with the curvature
+      // instead of visibly faceting per triangle. Falls back to the
+      // geometric normal where the interpolated one degenerates (opposed
+      // vertex normals across a crease).
+      glm::vec3 normal = geoNormal;
+      if (haveNormals) {
+        const glm::vec3 interpolated = mesh.normals[t * 3] * bary.x + mesh.normals[t * 3 + 1] * bary.y +
+                                        mesh.normals[t * 3 + 2] * bary.z;
+        const float len = glm::length(interpolated);
+        if (len > 1e-6f)
+          normal = interpolated / len;
+      }
+
+      // Local frame: x,y span the tangent plane, z is the normal — matching
+      // `scale` above, so the flattened axis is the one along the normal.
+      // Columns (t, b, n) in that order are right-handed (t x b == n), which
+      // is what quat_cast needs.
+      const glm::vec3 tangent = stableTangent(normal);
+      const glm::vec3 bitangent = glm::cross(normal, tangent);
+      const glm::quat q = glm::normalize(glm::quat_cast(glm::mat3(tangent, bitangent, normal)));
+
+      out.positions.push_back(position);
+      out.scales.push_back(scale);
+      out.rotations.push_back(glm::vec4(q.x, q.y, q.z, q.w)); // (x,y,z,w), see gsplat_asset.h
+      out.opacity.push_back(opacity);
+      out.colorDC.push_back(glm::clamp(splatColor(mesh, t, bary), 0.0f, 1.0f));
+    }
+  }
+
+  // Bounds over splat centres, same as the importer computes them
+  // (gsplat_ply_loader.cpp) — so camera framing behaves identically whether
+  // the splats were fitted here or loaded from a file.
+  out.boundsMin = glm::vec3(std::numeric_limits<float>::max());
+  out.boundsMax = glm::vec3(std::numeric_limits<float>::lowest());
+  for (const glm::vec3 &p : out.positions) {
+    out.boundsMin = glm::min(out.boundsMin, p);
+    out.boundsMax = glm::max(out.boundsMax, p);
+  }
+  return out;
+}
+
+} // namespace italy
