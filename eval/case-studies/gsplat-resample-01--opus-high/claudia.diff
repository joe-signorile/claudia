new file mode 100644
index 0000000..7976e1f
--- /dev/null
+++ b/src/convert/mesh_to_gsplat.h
@@ -0,0 +1,77 @@
+#pragma once
+
+#include <cstdint>
+
+#include "io/gsplat_asset.h"
+#include "io/mesh_asset.h"
+
+namespace italy {
+
+// Knobs for fitGsplatsToMesh(). Defaults are tuned to read as a solid,
+// correctly-coloured surface on the sort of single object this renderer
+// loads; only splatCount is exposed in the UI, the rest are here so they're
+// nameable rather than magic numbers buried in the .cpp.
+struct GsplatFitSettings {
+  // Total splats emitted. Exact, not approximate — the per-triangle quota is
+  // derived from a rounded running prefix of area, so the counts sum to this.
+  // 400k is where assets/test.glb stops losing small features (a speaker
+  // grille, button bevels) to the splat texture; the fit itself is cheap
+  // enough that the number is set by how much detail you want, not by cost.
+  int splatCount = 400000;
+
+  // Splat radius as a multiple of "the radius of a disk covering this splat's
+  // share of the surface area". Above 1 the disks overlap, which is what
+  // makes the surface read continuous instead of stippled; below 1 you can
+  // see through it.
+  //
+  // 2.2 by eye, from a sweep at 400k on assets/test.glb: 1.5 leaves a fine
+  // salt-and-pepper of rays slipping between splats to the dark interior
+  // (structural — it does not converge away with more samples), and 3.0
+  // starts bloating the silhouette and washing out dark detail.
+  float coverage = 2.2f;
+
+  // Sigma along the surface normal, as a fraction of the tangential radius.
+  // Small values give flat disks that hug the surface (what a mesh fit
+  // wants); 1.0 would give spheres, which bloat the silhouette. It also sets
+  // how far the renderer has to step a shading point off a splat to escape
+  // its own bounding ellipsoid, so flatter is cheaper there too — see the
+  // MATERIAL_GSPLAT branch of __closesthit__radiance.
+  float flatness = 0.2f;
+
+  // A mesh surface is opaque, so the splats standing in for it are too. The
+  // Gaussian falloff still gives soft, correctly alpha-blended edges.
+  float opacity = 1.0f;
+
+  // Fixed by default: a resample that moves under you between runs makes
+  // before/after image comparison (this repo's primary verification, see
+  // ITALY_DUMP_FRAME in humans.md) impossible.
+  uint32_t seed = 0x9e3779b9u;
+};
+
+// Fits a set of 3D Gaussian splats to a mesh's surface, producing the same
+// activated GsplatAsset the `.ply` importer produces — so the result renders
+// through the existing gsplat path (MATERIAL_GSPLAT custom-primitive
+// ellipsoids) and exports through gsplat_ply_writer.h with no special cases
+// anywhere downstream.
+//
+// This is an analytic single-pass fit, not the differentiable optimization a
+// 3DGS trainer runs: splats are placed by area-weighted stratified sampling
+// over the triangle soup, oriented to the interpolated shading normal,
+// flattened along it, and coloured from the base-colour texture at the
+// sampled UV. That is the right trade here — a fit you can re-run in under a
+// second at every splat count is one you'll actually iterate on (doctrine 2),
+// and unlike a training loop it needs no GPU, no rendered views, and no
+// convergence babysitting. What it gives up is per-splat anisotropy fitted
+// to local curvature; what it keeps is the surface's silhouette, normals and
+// albedo, which is what the image is made of.
+//
+// Pure host math (no OptiX, no CUDA), so it's unit-testable without a GPU —
+// see tests/mesh_to_gsplat_test.cpp. Deterministic for a given mesh and
+// settings.
+//
+// Returns an empty asset for a mesh with no triangles or zero total area;
+// callers should treat count() == 0 as a failure rather than handing the
+// renderer a zero-primitive scene.
+GsplatAsset fitGsplatsToMesh(const MeshAsset &mesh, const GsplatFitSettings &settings);
+
+} // namespace italy
