@@ -0,0 +1,28 @@
+#pragma once
+
+#include <string>
+
+#include "io/gsplat_asset.h"
+
+namespace italy {
+
+// Writes a GsplatAsset as a standard 3D Gaussian Splatting `.ply` — the
+// counterpart to loadGsplatPly(), and the export path for splats fitted from
+// a mesh (see convert/mesh_to_gsplat.h). Always `binary_little_endian`,
+// float32, with the property set every 3DGS viewer expects: x,y,z, nx,ny,nz,
+// f_dc_0-2, opacity, scale_0-2, rot_0-3.
+//
+// GsplatAsset holds activated values, so this undoes each activation on the
+// way out (log-scale, logit-opacity, RGB-to-SH-DC) using the inverses in
+// gsplat_asset.h — load(save(x)) round-trips to within float precision.
+//
+// Normals are written as zeros. The 3DGS format carries nx,ny,nz because its
+// PLY header was inherited from a point-cloud pipeline; the reference
+// implementation writes zeros there too, and nothing on either side of this
+// repo reads them.
+//
+// Returns false with a diagnostic in outError if the file can't be opened or
+// a write fails.
+bool saveGsplatPly(const std::string &path, const GsplatAsset &splats, std::string &outError);
+
+} // namespace italy
