+#pragma once
+
+#include "io/gsplat_asset.h"
+#include "io/mesh_asset.h"
+
+namespace italy {
+
+// Bounds on a splat budget, shared by the UI slider and the CLI parser so the
+// two can't disagree about what a legal budget is (same arrangement
+// kMinResolution/kMaxResolution have in main.cpp). The upper bound is a
+// memory bound, not a quality one: every splat costs ~56 bytes of per-
+// primitive device data plus its share of a custom-primitive BVH.
+constexpr int kMinSplatCount = 1;
+constexpr int kMaxSplatCount = 2000000;
+
+// Knobs for resampleMeshToGsplats(). Defaults are what an ordinary loaded GLB
+// wants; the three artist-facing ones are exposed as UI sliders (doctrine:
+// artist controls are features, not cheats).
+struct MeshToGsplatSettings {
+  // Total splats to place. The per-splat size is *derived* from this (see
+  // mesh_to_gsplat.cpp), so raising it makes the surface finer rather than
+  // denser-and-blurrier — the budget is the only knob that has to be right.
+  int splatCount = 200000;
+  // Multiplier on that derived size. 1.0 is the computed full-coverage value;
+  // below ~0.7 the surface starts showing pinholes, above ~2 it reads as fog.
+  float sizeScale = 1.0f;
+  // Standard deviation along the surface normal, as a fraction of the
+  // tangential one. Small — a fitted splat on a surface is a disk, not a ball.
+  float thickness = 0.25f;
+  // Peak opacity of one splat, before its Gaussian falloff.
+  float opacity = 0.9f;
+};
+
+// Fits a set of 3D Gaussian splats to a mesh's surface, producing the exact
+// GsplatAsset shape loadGsplatPly() produces — already-activated values, so
+// the result feeds the existing MATERIAL_GSPLAT render path (and
+// writeGsplatPly()) with nothing in between.
+//
+// This is an analytic surface placement, not an optimisation-based fit: splats
+// are laid down area-uniformly over the triangles as flat disks lying in the
+// surface, sized so their Gaussians tile it. Deliberate, per the doctrine
+// ladder — a gradient-descent fit against rendered views is a research-grade
+// problem costing minutes to hours per asset, which fails (2) outright, and at
+// any reasonable budget the analytic placement converges to the same soft
+// continuous surface such a fit would find. Instant and deterministic instead:
+// the same mesh and settings always produce byte-identical output, which is
+// what makes a before/after render comparison mean anything.
+//
+// Host-side only (no CUDA/OptiX — see CLAUDE.md's two-sanctioned-call-sites
+// rule). An empty or zero-area mesh yields an empty asset rather than failing.
+GsplatAsset resampleMeshToGsplats(const MeshAsset &mesh, const MeshToGsplatSettings &settings = {});
+
+} // namespace italy
