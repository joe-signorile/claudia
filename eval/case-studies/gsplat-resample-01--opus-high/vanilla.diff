diff --git a/src/io/gsplat_ply_writer.cpp b/src/io/gsplat_ply_writer.cpp
new file mode 100644
index 0000000..882d84b
--- /dev/null
+++ b/src/io/gsplat_ply_writer.cpp
@@ -0,0 +1,108 @@
+#include "io/gsplat_ply_writer.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <fstream>
+#include <vector>
+
+namespace italy {
+namespace {
+
+// Inverse of the loader's sigmoid. Clamped away from both ends first: a splat
+// at exactly 1.0 opacity (which the mesh fit can produce, and an artist can
+// ask for) has an infinite logit, and writing an `inf` produces a file most
+// readers accept and then render as garbage.
+float logit(float p) {
+  const float c = std::clamp(p, 1e-6f, 1.0f - 1e-6f);
+  return std::log(c / (1.0f - c));
+}
+
+void appendFloat(std::vector<char> &out, float v) {
+  char bytes[sizeof(float)];
+  std::memcpy(bytes, &v, sizeof(float));
+  out.insert(out.end(), bytes, bytes + sizeof(float));
+}
+
+} // namespace
+
+bool writeGsplatPly(const std::string &path, const GsplatAsset &splats, std::string &outError) {
+  std::ofstream file(path, std::ios::binary);
+  if (!file) {
+    outError = "gsplat: could not open " + path + " for writing";
+    return false;
+  }
+
+  // The reference implementation's exact property order for a degree-0 model:
+  // position, normal, SH DC, opacity, scale, rotation. nx/ny/nz are written as
+  // zeros, which is what that implementation writes too — GsplatAsset carries
+  // no normals, and no reader treats a splat's normal as meaningful. They are
+  // emitted at all because viewers that assume the reference layout index
+  // properties positionally rather than by name.
+  file << "ply\n"
+       << "format binary_little_endian 1.0\n"
+       << "comment generated by italy-rs (convert/mesh_to_gsplat.h)\n"
+       << "element vertex " << splats.count() << "\n"
+       << "property float x\nproperty float y\nproperty float z\n"
+       << "property float nx\nproperty float ny\nproperty float nz\n"
+       << "property float f_dc_0\nproperty float f_dc_1\nproperty float f_dc_2\n"
+       << "property float opacity\n"
+       << "property float scale_0\nproperty float scale_1\nproperty float scale_2\n"
+       << "property float rot_0\nproperty float rot_1\nproperty float rot_2\nproperty float rot_3\n"
+       << "end_header\n";
+
+  // One buffered block rather than a write per property: a million splats is
+  // 17 million four-byte writes otherwise, and this is reachable from a UI
+  // button.
+  constexpr size_t kFloatsPerVertex = 17;
+  std::vector<char> buffer;
+  buffer.reserve(splats.count() * kFloatsPerVertex * sizeof(float));
+
+  for (size_t i = 0; i < splats.count(); ++i) {
+    const glm::vec3 &p = splats.positions[i];
+    appendFloat(buffer, p.x);
+    appendFloat(buffer, p.y);
+    appendFloat(buffer, p.z);
+    appendFloat(buffer, 0.0f);
+    appendFloat(buffer, 0.0f);
+    appendFloat(buffer, 0.0f);
+
+    const glm::vec3 &c = splats.colorDC[i];
+    appendFloat(buffer, (c.r - 0.5f) / kSplatShC0);
+    appendFloat(buffer, (c.g - 0.5f) / kSplatShC0);
+    appendFloat(buffer, (c.b - 0.5f) / kSplatShC0);
+
+    appendFloat(buffer, logit(splats.opacity[i]));
+
+    // log of the activated scale. Floored, for the same reason logit() clamps:
+    // log(0) is -inf, and a zero scale shouldn't exist in the first place (see
+    // mesh_to_gsplat.cpp's scaleFloor).
+    const glm::vec3 &s = splats.scales[i];
+    appendFloat(buffer, std::log(std::max(s.x, 1e-20f)));
+    appendFloat(buffer, std::log(std::max(s.y, 1e-20f)));
+    appendFloat(buffer, std::log(std::max(s.z, 1e-20f)));
+
+    // Real part first — the 3DGS convention, and the component rotation the
+    // loader undoes on the way back in (see its rot_0 comment).
+    const glm::vec4 &r = splats.rotations[i];
+    appendFloat(buffer, r.w);
+    appendFloat(buffer, r.x);
+    appendFloat(buffer, r.y);
+    appendFloat(buffer, r.z);
+  }
+
+  file.write(buffer.data(), static_cast<std::streamsize>(buffer.size()));
+  if (!file) {
+    outError = "gsplat: failed writing splat data to " + path + " (disk full?)";
+    return false;
+  }
+  file.close();
+  if (!file) {
+    outError = "gsplat: failed to flush " + path;
+    return false;
+  }
+  return true;
+}
+
+} // namespace italy
diff --git a/src/io/gsplat_ply_writer.h b/src/io/gsplat_ply_writer.h
new file mode 100644
index 0000000..abf01ed
--- /dev/null
+++ b/src/io/gsplat_ply_writer.h
@@ -0,0 +1,21 @@
+#pragma once
+
+#include <string>
+
+#include "io/gsplat_asset.h"
+
+namespace italy {
+
+// Writes a GsplatAsset as a standard 3D Gaussian Splatting `.ply`
+// (`binary_little_endian`, the reference implementation's property order), so
+// a scene fitted by convert/mesh_to_gsplat.h can leave this app and be opened
+// by any 3DGS viewer — or read straight back in by loadGsplatPly().
+//
+// Applies the exact inverses of the loader's activation functions (log for
+// scale, logit for opacity, (rgb - 0.5) / kSplatShC0 for colour) so
+// write-then-load is a round trip, not an approximation.
+//
+// Returns false with a diagnostic in outError if the file can't be written.
+bool writeGsplatPly(const std::string &path, const GsplatAsset &splats, std::string &outError);
+
+} // namespace italy
diff --git a/src/render/kernels/pathtracer.cu b/src/render/kernels/pathtracer.cu
index f0391cc..7d595a5 100644
--- a/src/render/kernels/pathtracer.cu
+++ b/src/render/kernels/pathtracer.cu
@@ -803,12 +803,27 @@ extern "C" __global__ void __intersection__gsplat() {
 }
 
 // Stochastic alpha test: evaluate the actual (not just bounding-ellipsoid)
-// Gaussian density at the candidate hit point, multiply by the splat's
+// Gaussian density the ray sees through this splat, multiply by the splat's
 // opacity, and accept the hit with that probability — otherwise ignore it
 // and let the ray continue through. Unbiased in expectation over many
 // samples/subframes, and needs no per-pixel depth sort of overlapping
 // splats (doctrine: unbiased transport is kept for beauty, not realism).
 //
+// "The density the ray sees" is its *maximum along the ray*, i.e. the density
+// at the ray's closest approach to the splat centre — the standard ray-traced
+// 3DGS response (Moenne-Loccoz et al. 2024, "3D Gaussian Ray Tracing"), and
+// the discrete stand-in for rasterized 3DGS's integral of the Gaussian along
+// the view ray. Evaluating instead at the *candidate hit point* — which is
+// what this did until 2026-08-29 — pins every splat at
+// exp(-0.5 * GSPLAT_SIGMA_EXTENT^2) = exp(-4.5) ~= 1% alpha no matter its
+// opacity or where the ray passed, because __intersection__gsplat reports a
+// point on the 3-sigma shell by construction and the shell is precisely the
+// level set where that density is constant. The symptom is a splat scene that
+// renders as a faint ghost you can see the background through: ~90 overlapping
+// splats have to line up for one opaque pixel. It went unnoticed because the
+// phase-3 verification scene was a diffuse cloud of splats, where "soft and
+// see-through" was the expected look.
+//
 // Only ever reached by the camera/bounce radiance ray: traceOcclusion()
 // issues shadow rays with OPTIX_RAY_FLAG_DISABLE_ANYHIT (see its own
 // comment), so a splat's *shadow* is its full opaque bounding ellipsoid —
@@ -823,8 +838,19 @@ extern "C" __global__ void __anyhit__gsplat() {
   const float3 scale = rt->splatScales[i];
   const float4 rotation = rt->splatRotations[i];
 
-  const float3 hitP = optixGetWorldRayOrigin() + optixGetRayTmax() * optixGetWorldRayDirection();
-  const float3 sigma = splatLocalSigma(rotation, scale, hitP - center);
+  // Same sigma-space setup the intersector uses, so the two can't disagree
+  // about the splat's shape; here it's solved for the t of closest approach
+  // (d/dt of |so + t*sd|^2 = 0) rather than for the shell crossing.
+  const float3 rayO = optixGetWorldRayOrigin() - center;
+  const float3 rayD = optixGetWorldRayDirection();
+  const float3 so = splatLocalSigma(rotation, scale, rayO);
+  const float3 sd = quatRotate(quatConjugate(rotation), rayD) / scale;
+  const float a = dot(sd, sd);
+  // Clamped to the ray's own start: if the peak lies behind the origin (a ray
+  // that begins inside the splat, e.g. a bounce off one), the most the ray can
+  // actually see is at tmin, not at the unreachable peak.
+  const float tPeak = a > 0.0f ? fmaxf(-dot(so, sd) / a, optixGetRayTmin()) : optixGetRayTmin();
+  const float3 sigma = so + tPeak * sd;
   const float density = expf(-0.5f * dot(sigma, sigma));
   const float alpha = rt->splatOpacity[i] * density;
 
diff --git a/tests/gsplat_ply_loader_test.cpp b/tests/gsplat_ply_loader_test.cpp
index da11602..38a893f 100644
--- a/tests/gsplat_ply_loader_test.cpp
+++ b/tests/gsplat_ply_loader_test.cpp
@@ -88,6 +88,16 @@ int main() {
   // Vertex 1: opacity logit -2 -> sigmoid(-2) ~= 0.11920292.
   assert(std::abs(splats.opacity[1] - 0.11920292f) < 1e-5f);
 
+  // rot_0 is the quaternion's *real* part (3DGS convention), and GsplatAsset
+  // stores (x,y,z,w) — so vertex 0's "1 0 0 0" is the identity rotation, and
+  // vertex 1's "0 0 0 1" is a 180-degree turn about Z. Read straight through
+  // as (x,y,z,w), these come out as each other's opposite, which is invisible
+  // on an isotropic splat and wrong on every anisotropic one.
+  assert(std::abs(splats.rotations[0].w - 1.0f) < 1e-6f);
+  assert(std::abs(splats.rotations[0].x) < 1e-6f);
+  assert(std::abs(splats.rotations[1].z - 1.0f) < 1e-6f);
+  assert(std::abs(splats.rotations[1].w) < 1e-6f);
+
   // Bounds cover both positions.
   assert(splats.boundsMin.x <= -1.0f && splats.boundsMax.x >= 1.0f);
   assert(splats.boundsMin.y <= 0.0f && splats.boundsMax.y >= 2.0f);
diff --git a/tests/mesh_to_gsplat_test.cpp b/tests/mesh_to_gsplat_test.cpp
new file mode 100644
index 0000000..c5c3b23
--- /dev/null
+++ b/tests/mesh_to_gsplat_test.cpp
@@ -0,0 +1,235 @@
+// Standalone sanity check for the mesh -> 3D Gaussian splat fit
+// (convert/mesh_to_gsplat.cpp) and the PLY writer it feeds
+// (io/gsplat_ply_writer.cpp), matching this repo's other tests' tool-scale:
+// no framework, just asserts. Host-only — the fit never touches CUDA/OptiX.
+#include <cassert>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <vector>
+
+#include <glm/gtc/quaternion.hpp>
+
+#include "convert/mesh_to_gsplat.h"
+#include "io/gsplat_ply_loader.h"
+#include "io/gsplat_ply_writer.h"
+
+using italy::GsplatAsset;
+using italy::MeshAsset;
+using italy::MeshToGsplatSettings;
+using italy::resampleMeshToGsplats;
+
+namespace {
+
+// Adds one triangle with a constant normal — enough for the fit, which reads
+// positions, normals, uvs and the material table and nothing else.
+void addTriangle(MeshAsset &mesh, const glm::vec3 &a, const glm::vec3 &b, const glm::vec3 &c,
+                 const glm::vec3 &n, uint32_t material) {
+  mesh.positions.insert(mesh.positions.end(), {a, b, c});
+  mesh.normals.insert(mesh.normals.end(), {n, n, n});
+  mesh.uvs.insert(mesh.uvs.end(), {glm::vec2(0.0f), glm::vec2(0.0f), glm::vec2(0.0f)});
+  mesh.tangents.insert(mesh.tangents.end(), 3, glm::vec4(1.0f, 0.0f, 0.0f, 1.0f));
+  mesh.triangleMaterial.push_back(material);
+}
+
+// A `size` x `size` quad in the z = 0 plane, normal +Z, one material.
+MeshAsset makeQuad(float size, const glm::vec3 &baseColor) {
+  MeshAsset mesh;
+  italy::MaterialAsset mat;
+  mat.baseColorFactor = baseColor;
+  mesh.materials.push_back(mat);
+  const glm::vec3 n(0.0f, 0.0f, 1.0f);
+  addTriangle(mesh, {0, 0, 0}, {size, 0, 0}, {size, size, 0}, n, 0);
+  addTriangle(mesh, {0, 0, 0}, {size, size, 0}, {0, size, 0}, n, 0);
+  mesh.boundsMin = glm::vec3(0.0f);
+  mesh.boundsMax = glm::vec3(size, size, 0.0f);
+  return mesh;
+}
+
+bool nearly(float a, float b, float eps) { return std::abs(a - b) < eps; }
+
+} // namespace
+
+int main() {
+  // ------------------------------------------------------------------
+  // A flat quad: every property of the fit has a closed-form expectation.
+  // ------------------------------------------------------------------
+  const float kSize = 2.0f;
+  const glm::vec3 kColor(0.25f, 0.5f, 0.75f);
+  const MeshAsset quad = makeQuad(kSize, kColor);
+
+  MeshToGsplatSettings settings;
+  settings.splatCount = 4096;
+  settings.opacity = 0.9f;
+  settings.thickness = 0.25f;
+  const GsplatAsset splats = resampleMeshToGsplats(quad, settings);
+  assert(splats.count() == 4096);
+
+  for (size_t i = 0; i < splats.count(); ++i) {
+    // On the surface, and inside it.
+    assert(nearly(splats.positions[i].z, 0.0f, 1e-5f));
+    assert(splats.positions[i].x >= -1e-5f && splats.positions[i].x <= kSize + 1e-5f);
+    assert(splats.positions[i].y >= -1e-5f && splats.positions[i].y <= kSize + 1e-5f);
+
+    // Scales finite and positive, with the normal axis the short one: a fitted
+    // splat is a disk lying in the surface, not a ball.
+    const glm::vec3 s = splats.scales[i];
+    assert(std::isfinite(s.x) && std::isfinite(s.y) && std::isfinite(s.z));
+    assert(s.x > 0.0f && s.y > 0.0f && s.z > 0.0f);
+    assert(nearly(s.x, s.y, 1e-6f));
+    assert(s.z < s.x);
+    assert(nearly(s.z, s.x * settings.thickness, 1e-6f));
+
+    // Unit quaternion whose local +Z (the thin axis) is the surface normal.
+    // This is the assertion that catches an ONB axis-order slip, which would
+    // otherwise only show up as splats standing on edge in a render.
+    const glm::vec4 r = splats.rotations[i];
+    assert(nearly(glm::length(r), 1.0f, 1e-4f));
+    const glm::quat q(r.w, r.x, r.y, r.z);
+    const glm::vec3 localZ = q * glm::vec3(0.0f, 0.0f, 1.0f);
+    assert(nearly(localZ.z, 1.0f, 1e-4f));
+
+    assert(nearly(splats.opacity[i], 0.9f, 1e-6f));
+    assert(nearly(splats.colorDC[i].r, kColor.r, 1e-6f));
+    assert(nearly(splats.colorDC[i].g, kColor.g, 1e-6f));
+    assert(nearly(splats.colorDC[i].b, kColor.b, 1e-6f));
+  }
+
+  // Splat size is derived from the budget and the surface area, not tuned:
+  // sigma = 1.2 / sqrt(2*pi*opacity) * sqrt(area / count). Checked numerically
+  // rather than by eye, per this repo's own AgX cautionary tale.
+  {
+    const float area = kSize * kSize;
+    const float spacing = std::sqrt(area / static_cast<float>(settings.splatCount));
+    const float expected = 1.2f / std::sqrt(2.0f * 3.14159265358979323846f * settings.opacity) * spacing;
+    assert(nearly(splats.scales[0].x, expected, 1e-6f));
+  }
+
+  // Halving the budget must widen each splat by sqrt(2), or the surface would
+  // develop holes at low counts — the whole point of deriving the size.
+  {
+    MeshToGsplatSettings half = settings;
+    half.splatCount = settings.splatCount / 4;
+    const GsplatAsset coarse = resampleMeshToGsplats(quad, half);
+    assert(coarse.count() == static_cast<size_t>(half.splatCount));
+    assert(nearly(coarse.scales[0].x, splats.scales[0].x * 2.0f, 1e-5f));
+  }
+
+  // Bounds cover the quad (positions only, same as loadGsplatPly computes).
+  assert(splats.boundsMin.x >= -1e-5f && splats.boundsMax.x <= kSize + 1e-5f);
+  assert(splats.boundsMax.x > kSize * 0.9f && splats.boundsMax.y > kSize * 0.9f);
+
+  // ------------------------------------------------------------------
+  // Placement is area-proportional: a big quad and a quad of 1/4 its area,
+  // far apart, should get splats in a 4:1 ratio.
+  // ------------------------------------------------------------------
+  {
+    MeshAsset two;
+    italy::MaterialAsset mat;
+    two.materials.push_back(mat);
+    const glm::vec3 n(0.0f, 0.0f, 1.0f);
+    addTriangle(two, {0, 0, 0}, {2, 0, 0}, {2, 2, 0}, n, 0);
+    addTriangle(two, {0, 0, 0}, {2, 2, 0}, {0, 2, 0}, n, 0); // area 4
+    addTriangle(two, {10, 0, 0}, {11, 0, 0}, {11, 1, 0}, n, 0);
+    addTriangle(two, {10, 0, 0}, {11, 1, 0}, {10, 1, 0}, n, 0); // area 1
+    two.boundsMin = glm::vec3(0.0f);
+    two.boundsMax = glm::vec3(11.0f, 2.0f, 0.0f);
+
+    MeshToGsplatSettings s;
+    s.splatCount = 10000;
+    const GsplatAsset mixed = resampleMeshToGsplats(two, s);
+    int onSmall = 0;
+    for (const auto &p : mixed.positions)
+      if (p.x > 9.0f)
+        ++onSmall;
+    // Exactly 1/5 of the budget, up to the stratification's boundary splat.
+    assert(std::abs(onSmall - 2000) <= 2);
+  }
+
+  // ------------------------------------------------------------------
+  // Deterministic: the same mesh and settings give bit-identical output, so a
+  // before/after render comparison means something.
+  // ------------------------------------------------------------------
+  {
+    const GsplatAsset again = resampleMeshToGsplats(quad, settings);
+    assert(again.count() == splats.count());
+    for (size_t i = 0; i < splats.count(); ++i) {
+      assert(again.positions[i] == splats.positions[i]);
+      assert(again.scales[i] == splats.scales[i]);
+      assert(again.rotations[i] == splats.rotations[i]);
+      assert(again.opacity[i] == splats.opacity[i]);
+      assert(again.colorDC[i] == splats.colorDC[i]);
+    }
+  }
+
+  // ------------------------------------------------------------------
+  // Degenerate inputs produce an empty asset, not a crash or a NaN.
+  // ------------------------------------------------------------------
+  {
+    MeshAsset empty;
+    empty.materials.push_back(italy::MaterialAsset{});
+    assert(resampleMeshToGsplats(empty, settings).count() == 0);
+
+    MeshAsset zeroArea;
+    zeroArea.materials.push_back(italy::MaterialAsset{});
+    addTriangle(zeroArea, {0, 0, 0}, {1, 0, 0}, {1, 0, 0}, glm::vec3(0, 1, 0), 0);
+    assert(resampleMeshToGsplats(zeroArea, settings).count() == 0);
+  }
+
+  // ------------------------------------------------------------------
+  // Round trip through the writer and the loader. This is what pins both the
+  // activation inverses (log/logit/SH-DC) and the rot_0-is-the-real-part
+  // component order — a fit produces strongly anisotropic splats, so a
+  // swapped quaternion component here is a visibly wrong export.
+  // ------------------------------------------------------------------
+  {
+    // A tilted quad, so the fitted rotations are not the identity and a
+    // component swap can't accidentally survive.
+    MeshAsset tilted;
+    italy::MaterialAsset mat;
+    mat.baseColorFactor = glm::vec3(0.8f, 0.3f, 0.1f);
+    tilted.materials.push_back(mat);
+    const glm::vec3 n = glm::normalize(glm::vec3(1.0f, 2.0f, 3.0f));
+    addTriangle(tilted, {0, 0, 0}, {1, 0, glm::dot(glm::vec3(1, 0, 0), -n) / n.z},
+                {0, 1, glm::dot(glm::vec3(0, 1, 0), -n) / n.z}, n, 0);
+    tilted.boundsMin = glm::vec3(-1.0f);
+    tilted.boundsMax = glm::vec3(1.0f);
+
+    MeshToGsplatSettings s;
+    s.splatCount = 64;
+    const GsplatAsset fitted = resampleMeshToGsplats(tilted, s);
+    assert(fitted.count() == 64);
+
+    const std::string path = std::string(std::getenv("TMPDIR") ? std::getenv("TMPDIR") : "/tmp") +
+                             "/italy_mesh_to_gsplat_test.ply";
+    std::string err;
+    assert(italy::writeGsplatPly(path, fitted, err));
+    assert(err.empty());
+
+    GsplatAsset reloaded;
+    assert(italy::loadGsplatPly(path, reloaded, err));
+    assert(reloaded.count() == fitted.count());
+    for (size_t i = 0; i < fitted.count(); ++i) {
+      assert(nearly(reloaded.positions[i].x, fitted.positions[i].x, 1e-5f));
+      assert(nearly(reloaded.positions[i].y, fitted.positions[i].y, 1e-5f));
+      assert(nearly(reloaded.positions[i].z, fitted.positions[i].z, 1e-5f));
+      assert(nearly(reloaded.scales[i].x, fitted.scales[i].x, 1e-5f));
+      assert(nearly(reloaded.scales[i].z, fitted.scales[i].z, 1e-5f));
+      assert(nearly(reloaded.opacity[i], fitted.opacity[i], 1e-5f));
+      assert(nearly(reloaded.colorDC[i].r, fitted.colorDC[i].r, 1e-5f));
+      assert(nearly(reloaded.colorDC[i].b, fitted.colorDC[i].b, 1e-5f));
+      // Component-wise, not just "some rotation": this is the assertion the
+      // rot_0 ordering has to satisfy.
+      for (int c = 0; c < 4; ++c)
+        assert(nearly(reloaded.rotations[i][c], fitted.rotations[i][c], 1e-5f));
+      // And the orientation it encodes still points along the surface normal.
+      const glm::vec4 r = reloaded.rotations[i];
+      const glm::vec3 localZ = glm::quat(r.w, r.x, r.y, r.z) * glm::vec3(0.0f, 0.0f, 1.0f);
+      assert(nearly(glm::dot(localZ, n), 1.0f, 1e-3f));
+    }
+  }
+
+  std::printf("mesh_to_gsplat_test: OK\n");
+  return 0;
+}
