diff --git a/tests/mesh_to_gsplat_test.cpp b/tests/mesh_to_gsplat_test.cpp
new file mode 100644
index 0000000..86b8ed7
--- /dev/null
+++ b/tests/mesh_to_gsplat_test.cpp
@@ -0,0 +1,262 @@
+// Standalone sanity check for the mesh -> 3D-Gaussian-splat fit and the .ply
+// writer — no framework, just asserts, matching this repo's tool-scale.
+// Run via the `mesh_to_gsplat_test` CMake target.
+//
+// The fixture is a unit cube shell (same shape voxelize_test uses): its
+// surface is six known planes with six known normals, which makes "did the
+// splats land on the surface, oriented to it" checkable in closed form
+// rather than by eyeballing a render.
+#include <cassert>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+
+#include <glm/gtc/quaternion.hpp>
+
+#include "convert/mesh_to_gsplat.h"
+#include "io/gsplat_ply_loader.h"
+#include "io/gsplat_ply_writer.h"
+
+using italy::fitGsplatsToMesh;
+using italy::GsplatAsset;
+using italy::GsplatFitSettings;
+using italy::MeshAsset;
+
+namespace {
+
+void addQuad(MeshAsset &mesh, glm::vec3 a, glm::vec3 b, glm::vec3 c, glm::vec3 d, glm::vec3 n) {
+  for (glm::vec3 v : {a, b, c, a, c, d}) {
+    mesh.positions.push_back(v);
+    mesh.normals.push_back(n);
+    mesh.uvs.push_back(glm::vec2(0));
+  }
+}
+
+MeshAsset makeUnitCubeShell() {
+  MeshAsset mesh;
+  const glm::vec3 lo(0, 0, 0), hi(1, 1, 1);
+  addQuad(mesh, {lo.x, lo.y, lo.z}, {hi.x, lo.y, lo.z}, {hi.x, hi.y, lo.z}, {lo.x, hi.y, lo.z}, {0, 0, -1});
+  addQuad(mesh, {lo.x, lo.y, hi.z}, {lo.x, hi.y, hi.z}, {hi.x, hi.y, hi.z}, {hi.x, lo.y, hi.z}, {0, 0, 1});
+  addQuad(mesh, {lo.x, lo.y, lo.z}, {lo.x, hi.y, lo.z}, {lo.x, hi.y, hi.z}, {lo.x, lo.y, hi.z}, {-1, 0, 0});
+  addQuad(mesh, {hi.x, lo.y, lo.z}, {hi.x, lo.y, hi.z}, {hi.x, hi.y, hi.z}, {hi.x, hi.y, lo.z}, {1, 0, 0});
+  addQuad(mesh, {lo.x, lo.y, lo.z}, {lo.x, lo.y, hi.z}, {hi.x, lo.y, hi.z}, {hi.x, lo.y, lo.z}, {0, -1, 0});
+  addQuad(mesh, {lo.x, hi.y, lo.z}, {hi.x, hi.y, lo.z}, {hi.x, hi.y, hi.z}, {lo.x, hi.y, hi.z}, {0, 1, 0});
+  mesh.boundsMin = lo;
+  mesh.boundsMax = hi;
+  // materialForTriangle() indexes materials[0] as its fallback and loadGlb()
+  // normally guarantees the list is non-empty; a hand-built fixture has to
+  // uphold that invariant itself. Non-default colour so the test can tell a
+  // real lookup from a default-constructed one.
+  italy::MaterialAsset mat;
+  mat.baseColorFactor = glm::vec3(0.25f, 0.5f, 0.75f);
+  mesh.materials.push_back(mat);
+  return mesh;
+}
+
+// Distance from a point to the unit cube's shell (0 on the surface).
+float distanceToShell(const glm::vec3 &p) {
+  float best = 1e30f;
+  for (int axis = 0; axis < 3; ++axis) {
+    for (float plane : {0.0f, 1.0f}) {
+      // Only counts as "on this face" if the other two coordinates are
+      // inside the face's square, otherwise every point in space would read
+      // as 0 from some infinite plane.
+      bool inside = true;
+      for (int other = 0; other < 3; ++other) {
+        if (other == axis)
+          continue;
+        if (p[other] < -1e-4f || p[other] > 1.0f + 1e-4f)
+          inside = false;
+      }
+      if (inside)
+        best = std::min(best, std::abs(p[axis] - plane));
+    }
+  }
+  return best;
+}
+
+void testFitGeometry() {
+  const MeshAsset mesh = makeUnitCubeShell();
+  GsplatFitSettings settings;
+  settings.splatCount = 20000;
+  const GsplatAsset splats = fitGsplatsToMesh(mesh, settings);
+
+  // Exact, not approximate: the per-triangle quota telescopes off a rounded
+  // running area prefix specifically so this holds.
+  assert(splats.count() == 20000);
+  assert(splats.scales.size() == splats.count());
+  assert(splats.rotations.size() == splats.count());
+  assert(splats.opacity.size() == splats.count());
+  assert(splats.colorDC.size() == splats.count());
+
+  // Radius rule: each splat covers coverage^2 * (area / N) of surface. Total
+  // cube area is 6, so this pins the absolute scale, not just its sign.
+  const float expectedRadius = settings.coverage * std::sqrt(6.0f / (20000.0f * 3.14159265f));
+  assert(std::abs(splats.scales[0].x - expectedRadius) < 1e-5f);
+
+  for (size_t i = 0; i < splats.count(); ++i) {
+    assert(distanceToShell(splats.positions[i]) < 1e-4f);
+
+    const glm::vec3 &s = splats.scales[i];
+    assert(s.x > 0.0f && s.y > 0.0f && s.z > 0.0f);
+    assert(s.x == s.y);          // rotationally symmetric about the normal
+    assert(s.z < s.x * 0.5f);    // flattened onto the surface, not a sphere
+
+    const glm::vec4 &r = splats.rotations[i];
+    assert(std::abs(glm::length(r) - 1.0f) < 1e-4f);
+
+    // Local +z must be the surface normal. Every cube-shell normal is a
+    // cardinal axis, so the rotated axis has to be one too.
+    const glm::quat q(r.w, r.x, r.y, r.z);
+    const glm::vec3 localZ = q * glm::vec3(0, 0, 1);
+    float maxComponent = 0.0f;
+    for (int c = 0; c < 3; ++c)
+      maxComponent = std::max(maxComponent, std::abs(localZ[c]));
+    assert(maxComponent > 1.0f - 1e-4f);
+
+    assert(splats.opacity[i] >= 0.0f && splats.opacity[i] <= 1.0f);
+    assert(splats.opacity[i] == settings.opacity);
+    // Untextured material: colour is baseColorFactor straight through.
+    assert(std::abs(splats.colorDC[i].r - 0.25f) < 1e-5f);
+    assert(std::abs(splats.colorDC[i].g - 0.5f) < 1e-5f);
+    assert(std::abs(splats.colorDC[i].b - 0.75f) < 1e-5f);
+  }
+
+  // Splats reach every face, so the bounds are the cube's own.
+  assert(glm::length(splats.boundsMin - glm::vec3(0.0f)) < 0.02f);
+  assert(glm::length(splats.boundsMax - glm::vec3(1.0f)) < 0.02f);
+  std::printf("fit geometry ok (%zu splats)\n", splats.count());
+}
+
+void testCoverageScalesWithCount() {
+  const MeshAsset mesh = makeUnitCubeShell();
+  GsplatFitSettings a, b;
+  a.splatCount = 5000;
+  b.splatCount = 20000;
+  const GsplatAsset fa = fitGsplatsToMesh(mesh, a);
+  const GsplatAsset fb = fitGsplatsToMesh(mesh, b);
+  // 4x the splats over the same area => half the radius. This is what keeps
+  // the surface looking equally covered as the count knob moves.
+  const float ratio = fa.scales[0].x / fb.scales[0].x;
+  assert(std::abs(ratio - 2.0f) < 1e-3f);
+  std::printf("coverage scaling ok (radius ratio %.4f)\n", ratio);
+}
+
+void testDeterminism() {
+  const MeshAsset mesh = makeUnitCubeShell();
+  GsplatFitSettings settings;
+  settings.splatCount = 3000;
+  const GsplatAsset a = fitGsplatsToMesh(mesh, settings);
+  const GsplatAsset b = fitGsplatsToMesh(mesh, settings);
+  assert(a.count() == b.count());
+  for (size_t i = 0; i < a.count(); ++i) {
+    assert(a.positions[i] == b.positions[i]);
+    assert(a.rotations[i] == b.rotations[i]);
+  }
+  // A different seed has to actually move the samples, or the jitter that
+  // decorrelates neighbouring triangles isn't doing anything.
+  settings.seed ^= 0xabcdef01u;
+  const GsplatAsset c = fitGsplatsToMesh(mesh, settings);
+  bool differs = false;
+  for (size_t i = 0; i < a.count() && !differs; ++i)
+    differs = a.positions[i] != c.positions[i];
+  assert(differs);
+  std::printf("determinism ok\n");
+}
+
+void testDegenerateInput() {
+  MeshAsset empty;
+  empty.materials.push_back(italy::MaterialAsset{});
+  assert(fitGsplatsToMesh(empty, GsplatFitSettings{}).count() == 0);
+
+  // Three collinear points: a triangle with no area at all.
+  MeshAsset sliver;
+  sliver.materials.push_back(italy::MaterialAsset{});
+  for (glm::vec3 v : {glm::vec3(0, 0, 0), glm::vec3(1, 0, 0), glm::vec3(2, 0, 0)}) {
+    sliver.positions.push_back(v);
+    sliver.normals.push_back(glm::vec3(0, 1, 0));
+    sliver.uvs.push_back(glm::vec2(0));
+  }
+  assert(fitGsplatsToMesh(sliver, GsplatFitSettings{}).count() == 0);
+  std::printf("degenerate input ok\n");
+}
+
+// The real check on the writer: the existing importer reads back what it
+// wrote. Every activation the writer inverts has to land back where it
+// started, or an exported fit silently changes appearance on reload.
+void testPlyRoundTrip() {
+  const MeshAsset mesh = makeUnitCubeShell();
+  GsplatFitSettings settings;
+  settings.splatCount = 2000;
+  settings.opacity = 0.8f;
+  const GsplatAsset written = fitGsplatsToMesh(mesh, settings);
+
+  const std::string path = std::string(std::getenv("TMPDIR") ? std::getenv("TMPDIR") : "/tmp") +
+                            "/italy_mesh_to_gsplat_roundtrip.ply";
+  std::string err;
+  const bool saved = italy::saveGsplatPly(path, written, err);
+  if (!saved)
+    std::printf("save failed: %s\n", err.c_str());
+  assert(saved);
+
+  GsplatAsset read;
+  const bool loaded = italy::loadGsplatPly(path, read, err);
+  if (!loaded)
+    std::printf("load failed: %s\n", err.c_str());
+  assert(loaded);
+  assert(read.count() == written.count());
+
+  for (size_t i = 0; i < read.count(); ++i) {
+    assert(glm::length(read.positions[i] - written.positions[i]) < 1e-5f);
+    // Scale goes through log/exp and colour through the SH-DC pair, so these
+    // are relative-tolerance checks, not bit-exact ones.
+    for (int c = 0; c < 3; ++c) {
+      assert(std::abs(read.scales[i][c] - written.scales[i][c]) < 1e-6f * std::max(1.0f, written.scales[i][c]));
+      assert(std::abs(read.colorDC[i][c] - written.colorDC[i][c]) < 1e-4f);
+    }
+    assert(glm::length(read.rotations[i] - written.rotations[i]) < 1e-5f);
+    assert(std::abs(read.opacity[i] - written.opacity[i]) < 1e-4f);
+  }
+  assert(glm::length(read.boundsMin - written.boundsMin) < 1e-5f);
+  assert(glm::length(read.boundsMax - written.boundsMax) < 1e-5f);
+  std::remove(path.c_str());
+  std::printf("ply round-trip ok (%zu splats)\n", read.count());
+}
+
+// Opacity 1.0 is what the fit emits by default, and logit(1) is +inf — the
+// writer clamps for exactly this case. Checked separately because it's the
+// one value that would produce an unloadable file.
+void testFullyOpaqueRoundTrip() {
+  const MeshAsset mesh = makeUnitCubeShell();
+  GsplatFitSettings settings;
+  settings.splatCount = 1000;
+  settings.opacity = 1.0f;
+  const GsplatAsset written = fitGsplatsToMesh(mesh, settings);
+
+  const std::string path = std::string(std::getenv("TMPDIR") ? std::getenv("TMPDIR") : "/tmp") +
+                            "/italy_mesh_to_gsplat_opaque.ply";
+  std::string err;
+  assert(italy::saveGsplatPly(path, written, err));
+  GsplatAsset read;
+  assert(italy::loadGsplatPly(path, read, err));
+  for (size_t i = 0; i < read.count(); ++i) {
+    assert(std::isfinite(read.opacity[i]));
+    assert(read.opacity[i] > 0.999f && read.opacity[i] <= 1.0f);
+  }
+  std::remove(path.c_str());
+  std::printf("opaque round-trip ok\n");
+}
+
+} // namespace
+
+int main() {
+  testFitGeometry();
+  testCoverageScalesWithCount();
+  testDeterminism();
+  testDegenerateInput();
+  testPlyRoundTrip();
+  testFullyOpaqueRoundTrip();
+  std::printf("mesh_to_gsplat_test: all checks passed\n");
+  return 0;
+}
