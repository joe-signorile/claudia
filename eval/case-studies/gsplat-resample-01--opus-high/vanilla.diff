diff --git a/src/convert/mesh_color.h b/src/convert/mesh_color.h
new file mode 100644
index 0000000..9a002c0
--- /dev/null
+++ b/src/convert/mesh_color.h
@@ -0,0 +1,79 @@
+#pragma once
+
+// Resolving a loaded glTF surface's linear base colour at a point on a
+// triangle. Header-only and shared by every mesh resampler in this directory
+// (voxelize.cpp bakes one colour per occupied cell, mesh_to_gsplat.cpp one
+// per splat) — the two representations have to agree on what colour a given
+// piece of surface is, and the only way to guarantee that is one lookup.
+//
+// Lifted verbatim out of voxelize.cpp when the splat resampler needed the
+// same lookup at an arbitrary barycentric rather than only at the centroid;
+// the sRGB/V-flip reasoning below was learned the hard way there and is kept
+// with the code it belongs to.
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+
+#include <glm/glm.hpp>
+
+#include "io/mesh_asset.h"
+
+namespace italy {
+
+// glTF baseColorTexture is sRGB-encoded (baseColorFactor is linear — only
+// the texture needs decoding). The OptiX texture-sampling path gets this via
+// CUDA's hardware sRGB conversion (see optix_renderer.cpp); this CPU-side
+// bake has no such hardware, so it needs the standard sRGB EOTF explicitly.
+// Skipping it would systematically darken/mis-tint every colour baked from a
+// texture.
+inline float srgbToLinear(float c) {
+  return c <= 0.04045f ? c / 12.92f : std::pow((c + 0.055f) / 1.055f, 2.4f);
+}
+
+// No V flip: glTF's texture origin is the upper-left, TextureAsset stores rows
+// top-to-bottom (see mesh_asset.h), and the GPU path samples tex2D(u, v)
+// unflipped (pathtracer.cu's MATERIAL_TEXTURED_DIFFUSE branch). Flipping here
+// made the baked voxel colors a vertical mirror of what the same asset shows
+// when rendered as a mesh — the two representations have to agree.
+inline glm::vec3 sampleColorNearest(const TextureAsset &tex, glm::vec2 uv) {
+  auto wrap = [](float x) { return x - std::floor(x); };
+  const int px = std::clamp(static_cast<int>(wrap(uv.x) * tex.width), 0, tex.width - 1);
+  const int py = std::clamp(static_cast<int>(wrap(uv.y) * tex.height), 0, tex.height - 1);
+  const size_t idx = (static_cast<size_t>(py) * tex.width + px) * 4;
+  const glm::vec3 raw(tex.pixelsRGBA[idx] / 255.0f, tex.pixelsRGBA[idx + 1] / 255.0f,
+                      tex.pixelsRGBA[idx + 2] / 255.0f);
+  // Only base-colour textures are sRGB-encoded; the flag travels with the
+  // texture now, so a linear map that somehow reaches here isn't double-
+  // decoded (see TextureAsset::srgb).
+  if (!tex.srgb)
+    return raw;
+  return glm::vec3(srgbToLinear(raw.r), srgbToLinear(raw.g), srgbToLinear(raw.b));
+}
+
+// Linear base colour of `triangle` at barycentric `bary` (weights on the
+// triangle's three soup vertices, in order). Pass (1/3, 1/3, 1/3) for the
+// centroid.
+//
+// Only base colour is resolved — metallic/roughness/normal maps are dropped.
+// Every consumer of this header renders flat-diffuse (MATERIAL_VOXEL,
+// MATERIAL_SDF, MATERIAL_GSPLAT), so there is nowhere for a GGX lobe or a
+// tangent-space normal to go.
+inline glm::vec3 sampleBaseColorLinear(const MeshAsset &mesh, size_t triangle, const glm::vec3 &bary) {
+  // Per-triangle material lookup: one soup can now carry a whole scene's
+  // worth of materials, so the colour has to be resolved per triangle rather
+  // than once for the whole mesh.
+  const MaterialAsset &mat = mesh.materialForTriangle(triangle);
+  const size_t base = triangle * 3;
+  if (mat.baseColorTexture >= 0 && mat.baseColorTexture < static_cast<int>(mesh.textures.size()) &&
+      base + 2 < mesh.uvs.size()) {
+    const TextureAsset &tex = mesh.textures[mat.baseColorTexture];
+    if (tex.width > 0 && tex.height > 0) {
+      const glm::vec2 uv = bary.x * mesh.uvs[base] + bary.y * mesh.uvs[base + 1] + bary.z * mesh.uvs[base + 2];
+      return sampleColorNearest(tex, uv) * mat.baseColorFactor;
+    }
+  }
+  return mat.baseColorFactor;
+}
+
+} // namespace italy
diff --git a/src/convert/mesh_to_gsplat.cpp b/src/convert/mesh_to_gsplat.cpp
new file mode 100644
index 0000000..2e0ded7
--- /dev/null
+++ b/src/convert/mesh_to_gsplat.cpp
@@ -0,0 +1,197 @@
+#include "convert/mesh_to_gsplat.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <limits>
+#include <vector>
+
+#include <glm/gtc/quaternion.hpp>
+
+#include "convert/mesh_color.h"
+
+namespace italy {
+namespace {
+
+// Radical inverses in base 2 and 3 — the first two dimensions of a Halton
+// sequence. Used for the in-triangle position, so consecutive splats landing
+// on the same triangle spread out over it instead of clumping the way
+// independent random samples would. No PRNG anywhere in this file: the fit has
+// to be reproducible (see resampleMeshToGsplats' doc comment).
+float radicalInverse2(uint32_t i) {
+  i = (i << 16u) | (i >> 16u);
+  i = ((i & 0x55555555u) << 1u) | ((i & 0xAAAAAAAAu) >> 1u);
+  i = ((i & 0x33333333u) << 2u) | ((i & 0xCCCCCCCCu) >> 2u);
+  i = ((i & 0x0F0F0F0Fu) << 4u) | ((i & 0xF0F0F0F0u) >> 4u);
+  i = ((i & 0x00FF00FFu) << 8u) | ((i & 0xFF00FF00u) >> 8u);
+  return static_cast<float>(i) * 2.3283064365386963e-10f; // / 2^32
+}
+
+float radicalInverse3(uint32_t i) {
+  double result = 0.0;
+  double invBase = 1.0 / 3.0;
+  double f = invBase;
+  while (i > 0u) {
+    result += static_cast<double>(i % 3u) * f;
+    i /= 3u;
+    f *= invBase;
+  }
+  return static_cast<float>(result);
+}
+
+// Duff et al. 2017, "Building an Orthonormal Basis, Revisited": branchless,
+// and — unlike the usual "cross with whichever axis is least aligned" trick —
+// numerically well-behaved for every n including n.z near -1. (b1, b2, n) come
+// out right-handed and orthonormal, which matters because that triple is read
+// straight off as a rotation matrix below; a left-handed one would give
+// glm::quat_cast a reflection to invent a quaternion for.
+void branchlessOnb(const glm::vec3 &n, glm::vec3 &b1, glm::vec3 &b2) {
+  const float sign = std::copysign(1.0f, n.z);
+  const float a = -1.0f / (sign + n.z);
+  const float b = n.x * n.y * a;
+  b1 = glm::vec3(1.0f + sign * n.x * n.x * a, sign * b, -sign * n.x);
+  b2 = glm::vec3(b, sign + n.y * n.y * a, -n.y);
+}
+
+// How wide one splat has to be, in units of the mean spacing between splats,
+// for the surface to come out solid — derived rather than eyeballed, because
+// the budget slider has to work across its whole range and not just at
+// whichever count a hand-tuned constant was tuned at.
+//
+// A splat contributes a 2D Gaussian of peak alpha `o` and standard deviation
+// `s` to the surface, integrating to o*2*pi*s^2. At a mean spacing `d` there
+// are 1/d^2 splats per unit area, so the accumulated alpha per unit area is
+// o*2*pi*(s/d)^2. Setting that to 1 (fully covered, no pinholes, and no
+// wasted density piling up into a chalky over-blur) gives
+// s/d = 1/sqrt(2*pi*o) ~= 0.42 at the default opacity 0.9. 0.5 is that with a
+// little deliberate over-coverage, since real sampling is never perfectly
+// regular and a hole reads as a defect while slight extra overlap does not.
+float coverageSigmaOverSpacing(float opacity) {
+  const float ideal = 1.0f / std::sqrt(2.0f * 3.14159265358979323846f * std::max(opacity, 1e-3f));
+  return ideal * 1.2f;
+}
+
+} // namespace
+
+GsplatAsset resampleMeshToGsplats(const MeshAsset &mesh, const MeshToGsplatSettings &settings) {
+  GsplatAsset out;
+
+  const size_t triangleCount = mesh.triangleCount();
+  if (triangleCount == 0)
+    return out;
+
+  // Area CDF over triangles. Zero-area triangles (degenerate, and not rare in
+  // exported assets) contribute nothing and are skipped by construction: they
+  // leave the cumulative sum unchanged, so the search below can never land on
+  // one and divide by its zero area.
+  std::vector<float> cumulativeArea(triangleCount);
+  double total = 0.0;
+  for (size_t t = 0; t < triangleCount; ++t) {
+    const size_t base = t * 3;
+    const glm::vec3 e0 = mesh.positions[base + 1] - mesh.positions[base];
+    const glm::vec3 e1 = mesh.positions[base + 2] - mesh.positions[base];
+    total += 0.5 * static_cast<double>(glm::length(glm::cross(e0, e1)));
+    cumulativeArea[t] = static_cast<float>(total);
+  }
+  const float area = static_cast<float>(total);
+  if (!(area > 0.0f))
+    return out; // a mesh with no surface has no splats to fit to it
+
+  const int count = std::clamp(settings.splatCount, kMinSplatCount, kMaxSplatCount);
+  const size_t n = static_cast<size_t>(count);
+
+  // Mean spacing between splats if they tiled the surface evenly, and the
+  // Gaussian width that covers it (see coverageSigmaOverSpacing).
+  const float spacing = std::sqrt(area / static_cast<float>(n));
+  const float sigmaTangent = coverageSigmaOverSpacing(settings.opacity) * spacing * std::max(settings.sizeScale, 0.0f);
+  const float sigmaNormal = sigmaTangent * std::max(settings.thickness, 0.0f);
+  // Both axes floored well above zero: __intersection__gsplat divides the ray
+  // by the splat's scale componentwise, so a zero scale is not an invisible
+  // splat, it is a NaN that propagates into the accumulator. Scaled off the
+  // mesh's own extent so the floor means the same thing on a millimetre asset
+  // and a kilometre one.
+  const float scaleFloor = std::max(mesh.boundsRadius(), 1e-6f) * 1e-5f;
+  const glm::vec3 scale(std::max(sigmaTangent, scaleFloor), std::max(sigmaTangent, scaleFloor),
+                        std::max(sigmaNormal, scaleFloor));
+
+  const float opacity = std::clamp(settings.opacity, 0.01f, 1.0f);
+
+  out.positions.reserve(n);
+  out.scales.reserve(n);
+  out.rotations.reserve(n);
+  out.opacity.reserve(n);
+  out.colorDC.reserve(n);
+
+  for (size_t i = 0; i < n; ++i) {
+    // Stratified rather than random: one sample per equal slice of total area,
+    // taken in order. Area-proportional exactly (not just in expectation), and
+    // monotone in i, so the CDF search below walks forward instead of jumping
+    // — which also means consecutive splats on one triangle get consecutive,
+    // well-spread Halton points.
+    const float u = (static_cast<float>(i) + 0.5f) / static_cast<float>(n) * area;
+    size_t tri = static_cast<size_t>(std::lower_bound(cumulativeArea.begin(), cumulativeArea.end(), u) -
+                                     cumulativeArea.begin());
+    tri = std::min(tri, triangleCount - 1);
+
+    // Standard uniform-in-triangle warp of a 2D low-discrepancy point.
+    const float u1 = radicalInverse2(static_cast<uint32_t>(i));
+    const float u2 = radicalInverse3(static_cast<uint32_t>(i));
+    const float su = std::sqrt(u1);
+    const glm::vec3 bary(1.0f - su, u2 * su, su * (1.0f - u2));
+
+    const size_t base = tri * 3;
+    const glm::vec3 position =
+        bary.x * mesh.positions[base] + bary.y * mesh.positions[base + 1] + bary.z * mesh.positions[base + 2];
+
+    // Shading normals, not face normals: on a smooth asset they are what makes
+    // the splat disks follow the surface's curvature instead of faceting it,
+    // which is most of what separates this from a voxelization. gltf_loader
+    // always fills normals and never with a zero vector (it falls back to the
+    // face normal), but a barycentric blend across a hard crease can still
+    // cancel, so there is a fallback here too.
+    glm::vec3 normal =
+        bary.x * mesh.normals[base] + bary.y * mesh.normals[base + 1] + bary.z * mesh.normals[base + 2];
+    const float normalLength = glm::length(normal);
+    if (normalLength > 1e-8f) {
+      normal /= normalLength;
+    } else {
+      const glm::vec3 face = glm::cross(mesh.positions[base + 1] - mesh.positions[base],
+                                        mesh.positions[base + 2] - mesh.positions[base]);
+      const float faceLength = glm::length(face);
+      normal = faceLength > 0.0f ? face / faceLength : glm::vec3(0.0f, 1.0f, 0.0f);
+    }
+
+    // Local frame (tangent, bitangent, normal) as the columns of a rotation
+    // matrix, matching the scale vector's axis order above: the two wide axes
+    // lie in the surface, the thin one is along the normal.
+    glm::vec3 tangent, bitangent;
+    branchlessOnb(normal, tangent, bitangent);
+    const glm::quat q = glm::quat_cast(glm::mat3(tangent, bitangent, normal));
+
+    out.positions.push_back(position);
+    out.scales.push_back(scale);
+    out.rotations.push_back(glm::vec4(q.x, q.y, q.z, q.w)); // GsplatAsset stores (x,y,z,w)
+    out.opacity.push_back(opacity);
+    // realism: the fit keeps only base colour — metallic, roughness and normal
+    // maps are dropped. MATERIAL_GSPLAT shades flat-diffuse anyway (same tier
+    // as MATERIAL_VOXEL/MATERIAL_SDF), so there is nowhere for a GGX lobe to
+    // go; a chrome surface resampled to splats reads as matte paint. Sampling
+    // the same linear albedo the mesh path shades with is what makes a splat
+    // render read as a softened copy of the mesh render rather than a
+    // differently-coloured object.
+    out.colorDC.push_back(glm::clamp(sampleBaseColorLinear(mesh, tri, bary), 0.0f, 1.0f));
+  }
+
+  // Positions only, exactly as loadGsplatPly computes them — camera framing
+  // has to be identical whether a splat scene was fitted or imported.
+  out.boundsMin = glm::vec3(std::numeric_limits<float>::max());
+  out.boundsMax = glm::vec3(std::numeric_limits<float>::lowest());
+  for (const auto &p : out.positions) {
+    out.boundsMin = glm::min(out.boundsMin, p);
+    out.boundsMax = glm::max(out.boundsMax, p);
+  }
+
+  return out;
+}
+
+} // namespace italy
