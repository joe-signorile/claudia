diff --git a/src/io/gsplat_ply_writer.cpp b/src/io/gsplat_ply_writer.cpp
new file mode 100644
index 0000000..aaf8c1d
--- /dev/null
+++ b/src/io/gsplat_ply_writer.cpp
@@ -0,0 +1,89 @@
+#include "io/gsplat_ply_writer.h"
+
+#include <cstdint>
+#include <fstream>
+#include <vector>
+
+namespace italy {
+
+namespace {
+
+// One vertex record, in the exact order the header below declares. Written
+// as a packed struct rather than 17 separate stream writes: the record is
+// fixed-layout float32 either way, and one write per splat instead of
+// seventeen is the difference between a 1M-splat export finishing instantly
+// and grinding through 17M stream calls.
+//
+// static_assert'd below — if a compiler ever pads this, the file would be
+// silently misaligned garbage rather than a build failure.
+struct PlyVertex {
+  float x, y, z;
+  float nx, ny, nz;
+  float fDc[3];
+  float opacity;
+  float scale[3];
+  float rot[4];
+};
+static_assert(sizeof(PlyVertex) == 17 * sizeof(float), "PlyVertex must be tightly packed float32");
+
+} // namespace
+
+bool saveGsplatPly(const std::string &path, const GsplatAsset &splats, std::string &outError) {
+  std::ofstream file(path, std::ios::binary);
+  if (!file) {
+    outError = "gsplat: could not open for writing: " + path;
+    return false;
+  }
+
+  const size_t count = splats.count();
+  file << "ply\n"
+       << "format binary_little_endian 1.0\n"
+       << "element vertex " << count << "\n"
+       << "property float x\nproperty float y\nproperty float z\n"
+       << "property float nx\nproperty float ny\nproperty float nz\n"
+       << "property float f_dc_0\nproperty float f_dc_1\nproperty float f_dc_2\n"
+       << "property float opacity\n"
+       << "property float scale_0\nproperty float scale_1\nproperty float scale_2\n"
+       << "property float rot_0\nproperty float rot_1\nproperty float rot_2\nproperty float rot_3\n"
+       << "end_header\n";
+
+  std::vector<PlyVertex> records(count);
+  for (size_t i = 0; i < count; ++i) {
+    PlyVertex &r = records[i];
+    const glm::vec3 &p = splats.positions[i];
+    r.x = p.x;
+    r.y = p.y;
+    r.z = p.z;
+    r.nx = r.ny = r.nz = 0.0f;
+    for (int c = 0; c < 3; ++c)
+      r.fDc[c] = gsplatRgbToShDc(splats.colorDC[i][c]);
+    r.opacity = gsplatDeactivateOpacity(splats.opacity[i]);
+    for (int c = 0; c < 3; ++c)
+      r.scale[c] = gsplatDeactivateScale(splats.scales[i][c]);
+    // Quaternion component order matches what loadGsplatPly reads back:
+    // rot_0..rot_3 as (x,y,z,w). Worth knowing that the INRIA reference
+    // implementation writes them w-first — this repo's loader has always
+    // read them positionally as x,y,z,w, so writing them that way is what
+    // makes save/load round-trip here. A file written by this function and
+    // opened in an upstream 3DGS viewer will have its splats rotated by the
+    // wrong permutation until the loader's convention is fixed, which is a
+    // separate change with its own consequences for already-imported scenes.
+    const glm::vec4 &q = splats.rotations[i];
+    r.rot[0] = q.x;
+    r.rot[1] = q.y;
+    r.rot[2] = q.z;
+    r.rot[3] = q.w;
+  }
+
+  if (count > 0)
+    file.write(reinterpret_cast<const char *>(records.data()),
+               static_cast<std::streamsize>(records.size() * sizeof(PlyVertex)));
+  file.flush();
+  if (!file) {
+    outError = "gsplat: write failed (disk full or path not writable?): " + path;
+    return false;
+  }
+  return true;
+}
+
+} // namespace italy
