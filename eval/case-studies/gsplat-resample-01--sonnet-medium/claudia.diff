+// Standalone sanity check for the mesh->Gaussian-splat resampler — no
+// framework, just asserts, matching this repo's tool-scale rather than
+// pulling in a test runner for one file. Run via the `gsplat_resample_test`
+// CMake target.
+#include <cassert>
+#include <cmath>
+#include <cstdio>
+
+#include <glm/gtc/quaternion.hpp>
+
+#include "convert/gsplat_resample.h"
+
+using italy::MaterialAsset;
+using italy::MeshAsset;
+using italy::resampleMeshToGsplat;
+
+namespace {
+
+// A single unit quad (2 triangles) in the XY plane at z=0, normal +Z,
+// tangent +X, so every splat's expected orientation and bounds are known
+// exactly.
+MeshAsset makeUnitQuad() {
+  MeshAsset mesh;
+  const glm::vec3 n(0, 0, 1);
+  const glm::vec4 tan(1, 0, 0, 1);
+  auto addVert = [&](glm::vec3 p, glm::vec2 uv) {
+    mesh.positions.push_back(p);
+    mesh.normals.push_back(n);
+    mesh.tangents.push_back(tan);
+    mesh.uvs.push_back(uv);
+  };
+  // Two CCW triangles covering [0,1]x[0,1].
+  addVert({0, 0, 0}, {0, 0});
+  addVert({1, 0, 0}, {1, 0});
+  addVert({1, 1, 0}, {1, 1});
+  addVert({0, 0, 0}, {0, 0});
+  addVert({1, 1, 0}, {1, 1});
+  addVert({0, 1, 0}, {0, 1});
+  mesh.boundsMin = glm::vec3(0, 0, 0);
+  mesh.boundsMax = glm::vec3(1, 1, 0);
+  MaterialAsset mat;
+  mat.baseColorFactor = glm::vec3(1, 0, 0);
+  mesh.materials.push_back(mat);
+  return mesh;
+}
+
+} // namespace
+
+int main() {
+  const MeshAsset quad = makeUnitQuad();
+
+  // 1) Exact output count from the largest-remainder allocation.
+  {
+    const auto splats = resampleMeshToGsplat(quad, 2000);
+    assert(splats.count() == 2000);
+
+    // 2) Positions stay on the quad's surface (barycentric interpolation
+    //    doesn't leak off-triangle), and bounds match a manual recompute
+    //    over positions only (not padded by scale).
+    glm::vec3 lo(1e30f), hi(-1e30f);
+    for (size_t i = 0; i < splats.count(); ++i) {
+      const glm::vec3 &p = splats.positions[i];
+      assert(p.x >= -1e-4f && p.x <= 1.0f + 1e-4f);
+      assert(p.y >= -1e-4f && p.y <= 1.0f + 1e-4f);
+      assert(std::fabs(p.z) < 1e-4f);
+      lo = glm::min(lo, p);
+      hi = glm::max(hi, p);
+    }
+    assert(glm::all(glm::lessThan(glm::abs(lo - splats.boundsMin), glm::vec3(1e-5f))));
+    assert(glm::all(glm::lessThan(glm::abs(hi - splats.boundsMax), glm::vec3(1e-5f))));
+
+    // 3) Every splat's local +Z maps to the quad's known normal (+Z) — a
+    //    wrong axis convention or a reflection-matrix bug in quat_cast would
+    //    fail this immediately.
+    for (size_t i = 0; i < splats.count(); ++i) {
+      const glm::vec4 &r = splats.rotations[i];
+      const glm::quat q(r.w, r.x, r.y, r.z);
+      const glm::vec3 worldZ = glm::mat3_cast(q) * glm::vec3(0, 0, 1);
+      assert(glm::length(worldZ - glm::vec3(0, 0, 1)) < 1e-3f);
+    }
+
+    // 4) Disc shape: thin along local Z, uniform tangential radius across a
+    //    uniform-density flat quad.
+    const float sigmaT0 = splats.scales[0].x;
+    for (size_t i = 0; i < splats.count(); ++i) {
+      const glm::vec3 &s = splats.scales[i];
+      assert(s.z < s.x && s.z < s.y);
+      assert(std::fabs(s.x - sigmaT0) < 1e-5f);
+      assert(std::fabs(s.y - sigmaT0) < 1e-5f);
+    }
+
+    // 5) Color flows through baseColorFactor when untextured.
+    for (size_t i = 0; i < splats.count(); ++i)
+      assert(glm::length(splats.colorDC[i] - glm::vec3(1, 0, 0)) < 1e-5f);
+
+    // 6) Opacity is a constant in (0,1].
+    for (size_t i = 0; i < splats.count(); ++i)
+      assert(splats.opacity[i] > 0.0f && splats.opacity[i] <= 1.0f);
+
+    // 7) Quadrupling the target count halves sigmaT (sigmaT ~ sqrt(area/N)),
+    //    tying the formula to N/area rather than a hardcoded constant.
+    const auto splatsDense = resampleMeshToGsplat(quad, 8000);
+    assert(splatsDense.count() == 8000);
+    const float ratio = splatsDense.scales[0].x / sigmaT0;
+    assert(std::fabs(ratio - 0.5f) < 0.02f);
+  }
+
+  // 8) Edge cases: no crash, no divide-by-zero/NaN.
+  assert(resampleMeshToGsplat(quad, 0).count() == 0);
+  assert(resampleMeshToGsplat(MeshAsset{}, 100).count() == 0);
+
+  std::printf("gsplat_resample_test: OK\n");
+  return 0;
+}
