diff --git a/src/convert/gsplat_resample.cpp b/src/convert/gsplat_resample.cpp
new file mode 100644
index 0000000..1319dbd
--- /dev/null
+++ b/src/convert/gsplat_resample.cpp
@@ -0,0 +1,179 @@
+#include "convert/gsplat_resample.h"
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+#include <numeric>
+#include <random>
+
+#include <glm/gtc/quaternion.hpp>
+
+#include "convert/texture_sample.h"
+
+namespace italy {
+namespace {
+
+constexpr float kOverlapFactor = 1.2f;   // neighbor spacing -> sigmaT multiplier; bigger = more overlap, fewer gaps
+constexpr float kThicknessRatio = 0.12f; // sigmaN / sigmaT — how flat the disc is
+constexpr float kDefaultOpacity = 0.85f; // constant per-splat opacity fed into __anyhit__gsplat's stochastic accept
+
+// Duff et al. 2017 "Building an Orthonormal Basis, Revisited" — branchless.
+// Fallback for triangles whose interpolated tangent degenerates (near-zero
+// UV derivative / degenerate UVs) after Gram-Schmidt against the normal.
+void basisFromNormal(const glm::vec3 &n, glm::vec3 &t, glm::vec3 &b) {
+  const float s = n.z >= 0.0f ? 1.0f : -1.0f;
+  const float a = -1.0f / (s + n.z);
+  const float c = n.x * n.y * a;
+  t = glm::vec3(1.0f + s * n.x * n.x * a, s * c, -s * n.x);
+  b = glm::vec3(c, s + n.y * n.y * a, -n.y);
+}
+
+glm::vec3 triangleColorAt(const MeshAsset &mesh, size_t tri, glm::vec2 uv) {
+  const MaterialAsset &mat = mesh.materialForTriangle(tri);
+  if (mat.baseColorTexture >= 0 && mat.baseColorTexture < static_cast<int>(mesh.textures.size())) {
+    const TextureAsset &tex = mesh.textures[mat.baseColorTexture];
+    if (tex.width > 0 && tex.height > 0)
+      return sampleColorNearest(tex, uv) * mat.baseColorFactor;
+  }
+  return mat.baseColorFactor;
+}
+
+} // namespace
+
+GsplatAsset resampleMeshToGsplat(const MeshAsset &mesh, int targetSplatCount) {
+  GsplatAsset out;
+  const int n = std::max(targetSplatCount, 0);
+  const size_t triCount = mesh.triangleCount();
+  if (n == 0 || triCount == 0)
+    return out;
+
+  // Per-triangle area, total area.
+  std::vector<float> area(triCount);
+  double totalArea = 0.0;
+  for (size_t t = 0; t < triCount; ++t) {
+    const glm::vec3 &p0 = mesh.positions[t * 3];
+    const glm::vec3 &p1 = mesh.positions[t * 3 + 1];
+    const glm::vec3 &p2 = mesh.positions[t * 3 + 2];
+    area[t] = 0.5f * glm::length(glm::cross(p1 - p0, p2 - p0));
+    totalArea += area[t];
+  }
+
+  // Deterministic largest-remainder allocation of splat counts per triangle,
+  // proportional to area, summing to exactly n. A degenerate (zero-area)
+  // mesh falls back to a uniform per-triangle split so the function still
+  // returns n splats rather than 0.
+  std::vector<int> perTriCount(triCount, 0);
+  std::vector<float> exact(triCount);
+  int assigned = 0;
+  for (size_t t = 0; t < triCount; ++t) {
+    exact[t] =
+        totalArea > 0.0 ? static_cast<float>(area[t] / totalArea) * n : static_cast<float>(n) / static_cast<float>(triCount);
+    perTriCount[t] = static_cast<int>(exact[t]);
+    assigned += perTriCount[t];
+  }
+  int remainder = n - assigned;
+  std::vector<size_t> order(triCount);
+  std::iota(order.begin(), order.end(), 0);
+  std::sort(order.begin(), order.end(),
+            [&](size_t a, size_t b) { return (exact[a] - perTriCount[a]) > (exact[b] - perTriCount[b]); });
+  for (int i = 0; i < remainder && i < static_cast<int>(triCount); ++i)
+    perTriCount[order[i]] += 1;
+
+  // Global tangential/normal sigma from average sample spacing: for N points
+  // uniformly scattered over area A, average nearest-neighbor spacing is
+  // ~sqrt(A/N). Half that spacing puts neighboring splat centers ~2 sigma
+  // apart, so each splat's 3-sigma disc overlaps its neighbors enough to
+  // hide gaps from stochastic (non-lattice) placement.
+  const float boundsDiag = std::max(glm::length(mesh.boundsMax - mesh.boundsMin), 1e-6f);
+  const float spacing =
+      totalArea > 1e-12 ? std::sqrt(static_cast<float>(totalArea) / n) : boundsDiag / static_cast<float>(std::max(1, n));
+  const float sigmaT = std::max(0.5f * spacing * kOverlapFactor, boundsDiag * 1e-5f);
+  const float sigmaN = sigmaT * kThicknessRatio;
+
+  out.positions.reserve(n);
+  out.scales.reserve(n);
+  out.rotations.reserve(n);
+  out.opacity.reserve(n);
+  out.colorDC.reserve(n);
+
+  const bool haveTangents = mesh.tangents.size() >= mesh.positions.size();
+  const bool haveUvs = mesh.uvs.size() >= mesh.positions.size();
+
+  for (size_t t = 0; t < triCount; ++t) {
+    if (perTriCount[t] == 0)
+      continue;
+    const size_t base = t * 3;
+    const glm::vec3 &p0 = mesh.positions[base];
+    const glm::vec3 &p1 = mesh.positions[base + 1];
+    const glm::vec3 &p2 = mesh.positions[base + 2];
+    const glm::vec3 &n0 = mesh.normals[base];
+    const glm::vec3 &n1 = mesh.normals[base + 1];
+    const glm::vec3 &n2 = mesh.normals[base + 2];
+
+    std::mt19937 rng(static_cast<uint32_t>(t) * 2654435761u + 1u); // deterministic per-triangle seed
+    std::uniform_real_distribution<float> unit(0.0f, 1.0f);
+
+    for (int k = 0; k < perTriCount[t]; ++k) {
+      // Uniform-triangle barycentric sample (Shirley/Osada sqrt trick).
+      const float r1 = unit(rng), r2 = unit(rng);
+      const float sqrtR1 = std::sqrt(r1);
+      const float u = 1.0f - sqrtR1, v = r2 * sqrtR1, w = 1.0f - u - v;
+
+      const glm::vec3 pos = u * p0 + v * p1 + w * p2;
+      const glm::vec3 n = glm::normalize(u * n0 + v * n1 + w * n2);
+
+      glm::vec3 tangent(0.0f);
+      bool haveT = false;
+      if (haveTangents) {
+        const glm::vec3 tRaw = u * glm::vec3(mesh.tangents[base]) + v * glm::vec3(mesh.tangents[base + 1]) +
+                                w * glm::vec3(mesh.tangents[base + 2]);
+        const glm::vec3 tOrtho = tRaw - n * glm::dot(n, tRaw);
+        const float len = glm::length(tOrtho);
+        if (len > 1e-6f) {
+          tangent = tOrtho / len;
+          haveT = true;
+        }
+      }
+      glm::vec3 bitangent;
+      if (haveT) {
+        // Deliberately NOT multiplying by tangents.w (the bitangent sign).
+        // That sign only matters for normal-mapping chirality; using it here
+        // can make (tangent, bitangent, n) a reflection (det -1), which
+        // glm::quat_cast silently mishandles. Splat tangential scale is
+        // isotropic (sigmaT on both axes), so chirality is invisible —
+        // always take the right-handed cross(n, tangent).
+        bitangent = glm::cross(n, tangent);
+      } else {
+        basisFromNormal(n, tangent, bitangent);
+      }
+
+      const glm::mat3 rot(tangent, bitangent, n); // columns: local x,y,z -> world
+      const glm::quat q = glm::quat_cast(rot);
+
+      out.positions.push_back(pos);
+      out.scales.push_back(glm::vec3(sigmaT, sigmaT, sigmaN));
+      out.rotations.push_back(glm::vec4(q.x, q.y, q.z, q.w));
+      out.opacity.push_back(kDefaultOpacity);
+
+      glm::vec3 color = mesh.materialForTriangle(t).baseColorFactor;
+      if (haveUvs) {
+        const glm::vec2 uv = u * mesh.uvs[base] + v * mesh.uvs[base + 1] + w * mesh.uvs[base + 2];
+        color = triangleColorAt(mesh, t, uv);
+      }
+      out.colorDC.push_back(glm::clamp(color, 0.0f, 1.0f));
+    }
+  }
+
+  // Bounds = min/max of positions only, matching gsplat_ply_loader.cpp's
+  // convention — NOT fattened by scale (that's computeSplatAabb's job, used
+  // per-splat by the renderer's BVH, a different and larger quantity).
+  out.boundsMin = glm::vec3(std::numeric_limits<float>::max());
+  out.boundsMax = glm::vec3(std::numeric_limits<float>::lowest());
+  for (const auto &p : out.positions) {
+    out.boundsMin = glm::min(out.boundsMin, p);
+    out.boundsMax = glm::max(out.boundsMax, p);
+  }
+  return out;
+}
+
+} // namespace italy
diff --git a/src/convert/gsplat_resample.h b/src/convert/gsplat_resample.h
new file mode 100644
index 0000000..891f4a3
--- /dev/null
+++ b/src/convert/gsplat_resample.h
@@ -0,0 +1,22 @@
+#pragma once
+
+#include "io/gsplat_asset.h"
+#include "io/mesh_asset.h"
+
+namespace italy {
+
+// Resamples a mesh's surface into a Gaussian-splat point set: area-weighted
+// placement of one flattened (disc-shaped) splat per sample, oriented to the
+// local tangent frame so each splat lies flush with the surface. Pure CPU —
+// no OptiX/CUDA — since nothing here needs GPU raycasting (see voxelize.h
+// for the sibling pure-CPU mesh resampler this follows; sdf_baker.cpp/
+// src/render/ remain the only two sanctioned OptiX call sites).
+//
+// `targetSplatCount` is the only public knob (mirrors voxelizeMesh's/
+// bakeSdf's single `resolution` int): the output count is exact for meshes
+// with positive surface area, via deterministic area-proportional
+// allocation per triangle rather than a stochastic accept/reject over
+// samples (see .cpp).
+GsplatAsset resampleMeshToGsplat(const MeshAsset &mesh, int targetSplatCount);
+
+} // namespace italy
diff --git a/src/convert/texture_sample.h b/src/convert/texture_sample.h
new file mode 100644
index 0000000..6ede8e3
--- /dev/null
+++ b/src/convert/texture_sample.h
@@ -0,0 +1,41 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+
+#include <glm/glm.hpp>
+
+#include "io/mesh_asset.h"
+
+namespace italy {
+
+// glTF baseColorTexture is sRGB-encoded (baseColorFactor is linear — only
+// the texture needs decoding). The OptiX texture-sampling path gets this via
+// CUDA's hardware sRGB conversion (see optix_renderer.cpp); CPU-side bakes
+// (voxelize, gsplat resample) have no such hardware, so they need the
+// standard sRGB EOTF explicitly. Skipping it would systematically darken/
+// mis-tint every baked color sourced from a texture.
+inline float srgbToLinear(float c) { return c <= 0.04045f ? c / 12.92f : std::pow((c + 0.055f) / 1.055f, 2.4f); }
+
+// No V flip: glTF's texture origin is the upper-left, TextureAsset stores rows
+// top-to-bottom (see mesh_asset.h), and the GPU path samples tex2D(u, v)
+// unflipped (pathtracer.cu's MATERIAL_TEXTURED_DIFFUSE branch). Flipping here
+// would make a CPU bake a vertical mirror of what the same asset shows when
+// rendered as a mesh — the representations have to agree.
+inline glm::vec3 sampleColorNearest(const TextureAsset &tex, glm::vec2 uv) {
+  auto wrap = [](float x) { return x - std::floor(x); };
+  const int px = std::clamp(static_cast<int>(wrap(uv.x) * tex.width), 0, tex.width - 1);
+  const int py = std::clamp(static_cast<int>(wrap(uv.y) * tex.height), 0, tex.height - 1);
+  const size_t idx = (static_cast<size_t>(py) * tex.width + px) * 4;
+  const glm::vec3 raw(tex.pixelsRGBA[idx] / 255.0f, tex.pixelsRGBA[idx + 1] / 255.0f,
+                       tex.pixelsRGBA[idx + 2] / 255.0f);
+  // Only base-colour textures are sRGB-encoded; the flag travels with the
+  // texture now, so a linear map that somehow reaches here isn't double-
+  // decoded (see TextureAsset::srgb).
+  if (!tex.srgb)
+    return raw;
+  return glm::vec3(srgbToLinear(raw.r), srgbToLinear(raw.g), srgbToLinear(raw.b));
+}
+
+} // namespace italy
