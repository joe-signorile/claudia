diff --git a/src/convert/texture_sample.h b/src/convert/texture_sample.h
new file mode 100644
index 0000000..e046c4d
--- /dev/null
+++ b/src/convert/texture_sample.h
@@ -0,0 +1,80 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+
+#include <glm/glm.hpp>
+
+#include "io/mesh_asset.h"
+
+namespace italy {
+
+// CPU-side base-colour texture sampling, shared by the mesh resamplers.
+//
+// Every converter under src/convert/ that bakes a mesh's albedo into a
+// non-mesh representation needs the same two things: an sRGB decode, and a
+// wrapped texel fetch. This existed privately in voxelize.cpp and again
+// inside sdf_baker.cpp; mesh_to_gsplat.cpp would have been a third copy, so
+// it lives here instead. The GPU path doesn't use any of this — CUDA texture
+// hardware does the decode and filtering there (see optix_renderer.cpp).
+
+// glTF baseColorTexture is sRGB-encoded (baseColorFactor is linear — only
+// the texture needs decoding). Skipping this systematically darkens and
+// mis-tints every colour baked from a texture.
+inline float srgbToLinear(float c) {
+  return c <= 0.04045f ? c / 12.92f : std::pow((c + 0.055f) / 1.055f, 2.4f);
+}
+
+// No V flip: glTF's texture origin is the upper-left, TextureAsset stores
+// rows top-to-bottom (see mesh_asset.h), and the GPU path samples tex2D(u, v)
+// unflipped (pathtracer.cu's MATERIAL_TEXTURED_DIFFUSE branch). Flipping here
+// made baked voxel colours a vertical mirror of what the same asset shows
+// when rendered as a mesh — the representations have to agree.
+inline glm::vec3 texelAt(const TextureAsset &tex, int px, int py) {
+  px = std::clamp(px, 0, tex.width - 1);
+  py = std::clamp(py, 0, tex.height - 1);
+  const size_t idx = (static_cast<size_t>(py) * tex.width + px) * 4;
+  const glm::vec3 raw(tex.pixelsRGBA[idx] / 255.0f, tex.pixelsRGBA[idx + 1] / 255.0f,
+                      tex.pixelsRGBA[idx + 2] / 255.0f);
+  // Only base-colour textures are sRGB-encoded; the flag travels with the
+  // texture, so a linear map that somehow reaches here isn't double-decoded
+  // (see TextureAsset::srgb).
+  if (!tex.srgb)
+    return raw;
+  return glm::vec3(srgbToLinear(raw.r), srgbToLinear(raw.g), srgbToLinear(raw.b));
+}
+
+inline float wrapUv(float x) { return x - std::floor(x); }
+
+inline glm::vec3 sampleColorNearest(const TextureAsset &tex, glm::vec2 uv) {
+  return texelAt(tex, static_cast<int>(wrapUv(uv.x) * tex.width), static_cast<int>(wrapUv(uv.y) * tex.height));
+}
+
+// Bilinear variant, for converters that sample at scattered points rather
+// than once per cell. A voxel averages many samples and hides nearest-
+// neighbour blockiness; one splat gets exactly one texel lookup, so on a
+// low-resolution texture nearest turns a smooth gradient into visible
+// colour banding across neighbouring splats (doctrine 1). Wraps in both
+// axes, matching glTF's default REPEAT.
+inline glm::vec3 sampleColorBilinear(const TextureAsset &tex, glm::vec2 uv) {
+  const float fx = wrapUv(uv.x) * tex.width - 0.5f;
+  const float fy = wrapUv(uv.y) * tex.height - 0.5f;
+  const int x0 = static_cast<int>(std::floor(fx));
+  const int y0 = static_cast<int>(std::floor(fy));
+  const float tx = fx - x0;
+  const float ty = fy - y0;
+  // Wrap the upper neighbours rather than clamping them: clamping would
+  // seam every tiling texture at u=1/v=1.
+  auto wrapIndex = [](int i, int n) { return ((i % n) + n) % n; };
+  const int x1 = wrapIndex(x0 + 1, tex.width);
+  const int y1 = wrapIndex(y0 + 1, tex.height);
+  const int wx0 = wrapIndex(x0, tex.width);
+  const int wy0 = wrapIndex(y0, tex.height);
+  const glm::vec3 c00 = texelAt(tex, wx0, wy0);
+  const glm::vec3 c10 = texelAt(tex, x1, wy0);
+  const glm::vec3 c01 = texelAt(tex, wx0, y1);
+  const glm::vec3 c11 = texelAt(tex, x1, y1);
+  return glm::mix(glm::mix(c00, c10, tx), glm::mix(c01, c11, tx), ty);
+}
+
+} // namespace italy
